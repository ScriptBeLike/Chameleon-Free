	local button = script.Parent
	
	local function Click()
		local purple = script.Parent
	
		purple.BackgroundColor3 = Color3.fromRGB(115, 41, 229)
	
		local TweenService = game:GetService("TweenService")
		local Players = game:GetService("Players")
		local SoundService = game:GetService("SoundService")
	
		-- Define the Sound ID
		local soundId = "rbxassetid://9059725878"
	
		-- Creating the pop-up text GUI function
		local function createPopupText(bonds)
			local screenGui = Instance.new("ScreenGui", Players.LocalPlayer:WaitForChild("PlayerGui"))
			local textLabel = Instance.new("TextLabel")
	
			textLabel.Size = UDim2.new(0, 300, 0, 100)
			textLabel.Position = UDim2.new(0.5, -150, 0.5, -50)
			textLabel.Text = "Bonds Collected: +" .. bonds
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- White text
			textLabel.BackgroundTransparency = 1 -- Transparent background
			textLabel.Font = Enum.Font.Montserrat
			textLabel.TextScaled = true -- Automatically scales the text
			textLabel.TextStrokeTransparency = 0.5 -- Stroke effect
			textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0) -- Stroke color (black)
			textLabel.Parent = screenGui
	
			-- Fade out effect
			local tweenOut = TweenService:Create(textLabel, TweenInfo.new(1, Enum.EasingStyle.Linear), {TextTransparency = 1})
			tweenOut:Play()
			tweenOut.Completed:Wait() -- Wait for the tween to complete
			screenGui:Destroy() -- Remove the GUI after display
		end
	
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
	
		-- Define target position and tween info
		local targetCFrame = CFrame.new(-424, 30, -49041)
		local tweenInfo = TweenInfo.new(110, Enum.EasingStyle.Linear)
		local tween = TweenService:Create(character.HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
	
		-- Function to reset player character (cause player to die)
		local function resetCharacter()
			humanoid.Health = 0 -- Causes the player to die and respawn
		end
	
		-- Play the tween
		tween:Play()
	
		-- Function to display pop-up text every 3 seconds and play sound every 2 seconds
		local function displayNotifications()
			while humanoid.Health > 0 do -- While the player is alive
				local bonds = math.random(1, 3) -- Randomly generate 1, 2, or 3
				createPopupText(bonds)
				wait(3) -- Wait for pop-up
	
				-- Play sound
				local sound = Instance.new("Sound")
				sound.SoundId = soundId
				sound.Parent = SoundService
				sound:Play()
				wait(2) -- Wait for 2 seconds before the next pop-up or sound
			end
		end
	
		-- Start displaying notifications
		local popUpThread = coroutine.create(displayNotifications)
		coroutine.resume(popUpThread)
	
		-- Wait for 50 seconds, then reset the character and stop the tween
		wait(50)
		resetCharacter()
		tween:Cancel() -- Stops the tween when the player dies
	end
	
	button.MouseButton1Down:Connect(Click)
